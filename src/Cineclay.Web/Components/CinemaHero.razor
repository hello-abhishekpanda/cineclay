@implements IAsyncDisposable
@if(Current is {} movie){<section class="hero-grid"><article class="hero dynamic-hero"><img src="@(movie.Id==693134?"hero.jpg":movie.Poster)" alt="@movie.Title promotional artwork"/><div class="hero-content"><span class="hero-tag">✦ TOP 20 · LATEST IN THIS CATALOG</span><div class="hero-bottom"><div class="meta"><span class="hero-rank">#@((Index+1).ToString("00"))</span><span>@(movie.MediaType=="tv"?"TV SERIES":"MOVIE")</span><span>@movie.Year</span><span>@string.Join(" · ",movie.Genres.Take(2))</span></div><h2>@movie.Title</h2><p>@(movie.Summary.Length>180?movie.Summary[..177]+"…":movie.Summary)</p><div class="hero-buttons"><button class="primary" @onclick="()=>Explore.InvokeAsync(movie)">Explore @(movie.MediaType=="tv"?"series":"film") ↗</button>@if(movie.Trailer!=""){<button class="glass" @onclick="()=>Trailer.InvokeAsync(movie)">▷ Watch trailer</button>}@if(movie.Providers.FirstOrDefault(p=>p.Region=="IN"||p.Region=="GLOBAL") is {} offer){<a class="glass hero-watch" href="@offer.Url" target="_blank" rel="noopener">@if(ProviderLink.Logo(offer.Name)!=""){<img class="ott-logo" src="@ProviderLink.Logo(offer.Name)" alt="@offer.Name logo"/>} Official watch page ↗</a>}</div></div><div class="hero-navigation"><button @onclick="()=>Paused=!Paused" aria-label="Pause or play slideshow">@(Paused?"▷":"Ⅱ")</button><button @onclick="Previous" aria-label="Previous featured title">←</button><span>@(Index+1) / @Top.Count</span><button @onclick="Next" aria-label="Next featured title">→</button></div></div></article><aside class="top-ten-panel"><div class="top-ten-head"><span class="eyebrow">The latest edit</span><h2>Twenty stories.<br/>Endless possibilities.</h2><div class="hero-type-tabs"><button @onclick="()=>Mode(0)">All</button><button @onclick="()=>Mode(1)">Films</button><button @onclick="()=>Mode(2)">Series</button></div></div><div class="top-ten-list">@for(var i=0;i<Top.Count;i++){var n=i;var title=Top[i];<button class="@(Index==n?"active":"")" @onclick="()=>Index=n"><span>@((n+1).ToString("00"))</span><img src="@title.Poster" alt=""/><div><strong>@title.Title</strong><small>@title.Year · @(title.MediaType=="tv"?"TV series":"Movie")</small></div><i>↗</i></button>}</div><p class="note">Newest premiere years in your enriched catalog. Not a global streaming chart.</p></aside></section>}
@code{
 [Parameter]public List<Movie> Titles{get;set;}=[];[Parameter]public EventCallback<Movie> Explore{get;set;}[Parameter]public EventCallback<Movie> Trailer{get;set;}
 int Index,Media;bool Paused;readonly CancellationTokenSource Stop=new();Task? Rotation;
 protected override void OnAfterRender(bool first){if(first)Rotation=Rotate();}
 async Task Rotate(){try{using var timer=new PeriodicTimer(TimeSpan.FromSeconds(7));while(await timer.WaitForNextTickAsync(Stop.Token)){if(!Paused&&Top.Count>1)await InvokeAsync(()=>{Next();StateHasChanged();});}}catch(OperationCanceledException){}}
 public async ValueTask DisposeAsync(){Stop.Cancel();if(Rotation!=null)await Rotation;Stop.Dispose();}
 List<Movie> Top=>Titles.Where(m=>Media==0||m.MediaType==(Media==1?"movie":"tv")).OrderByDescending(m=>m.Year).ThenByDescending(m=>m.Score).Take(20).ToList();Movie? Current=>Top.ElementAtOrDefault(Index);
 void Mode(int mode){Media=mode;Index=0;}void Next(){Index=(Index+1)%Top.Count;}void Previous(){Index=(Index+Top.Count-1)%Top.Count;}
}
