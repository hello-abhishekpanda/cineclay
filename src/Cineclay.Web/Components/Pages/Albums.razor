@page "/albums"
@inject CatalogClient Api

<PageTitle>Albums — Cineclay</PageTitle>

<section class="album-page">
    <div class="intro">
        <div>
            <span class="eyebrow">Music across the years</span>
            <h1>Albums & songs</h1>
        </div>
        <p>Odia, Hindi and English music from 2000 to @DateTime.Now.Year.</p>
    </div>

    @if (Error is not null)
    {
        <div class="notice" role="alert">@Error <button class="secondary" @onclick="Load">Try again</button></div>
    }

    <div class="filters">
        <label class="search">
            ⌕
            <input type="search" aria-label="Search albums and songs" placeholder="Search albums, songs, artists…" @bind="Query" @bind:event="oninput" @onkeyup="SearchKey" />
        </label>
        <button class="secondary" @onclick="Search">Search</button>
        <select aria-label="Music language" @bind="Language" @bind:after="Search">
            <option value="">All languages</option>
            <option>Odia</option>
            <option>Hindi</option>
            <option>English</option>
        </select>
        <select aria-label="Release year" @bind="Year" @bind:after="Search">
            <option value="">All years</option>
            @for (var year = DateTime.Now.Year; year >= 2000; year--)
            {
                <option value="@year">@year</option>
            }
        </select>
    </div>

    <div class="album-results" aria-busy="@Busy">
        @if (Busy)
        {
            <div class="catalog-loader" role="status" aria-live="polite">
                <span class="loading-orb" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>Finding music</strong>
                <small>Loading albums and songs…</small>
            </div>
        }
        <div class="album-grid @(Busy ? "is-loading" : "")">
            @foreach (var album in AlbumItems)
            {
                <article class="album-card">
                    <img src="@album.Cover" alt="Cover for @album.Title" loading="lazy" />
                    <div class="album-copy">
                        <span class="eyebrow">@album.Language · @album.Year</span>
                        <h2>@album.Title</h2>
                        <p>@album.Artist</p>
                        <ol>
                            @foreach (var song in album.Songs)
                            {
                                <li>
                                    <a href="https://www.youtube.com/watch?v=@song.YouTubeVideoId" target="_blank" rel="noopener noreferrer">
                                        <span>▷</span>
                                        <span><strong>@song.Title</strong><small>@song.Artist</small></span>
                                    </a>
                                </li>
                            }
                        </ol>
                    </div>
                </article>
            }
        </div>
    </div>

    @if (!Busy && AlbumItems.Count == 0)
    {
        <div class="empty">
            <h3>No albums found.</h3>
            <p>Try another language, year, or search.</p>
        </div>
    }

    <nav class="catalog-pagination album-pagination" aria-label="Album pagination">
        <button class="page-direction" disabled="@(Page == 1 || Busy)" @onclick="Previous"><span aria-hidden="true">←</span> Previous</button>
        <div class="page-status">
            <strong>@Total.ToString("N0") albums</strong>
            <span>Odia, Hindi and English collections</span>
        </div>
        <div class="page-numbers">
            @for (var number = Math.Max(1, Page - 2); number <= Math.Min(PageCount, Page + 2); number++)
            {
                var destination = number;
                <button class="page-number @(number == Page ? "active" : "")" aria-current="@(number == Page ? "page" : null)" @onclick="() => GoTo(destination)">@number</button>
            }
        </div>
        <span class="page-count">Page @Page of @PageCount</span>
        <button class="page-direction" disabled="@(Page >= PageCount || Busy)" @onclick="Next">Next <span aria-hidden="true">→</span></button>
    </nav>
</section>

@code {
    readonly List<Album> AlbumItems = [];
    string Query = "";
    string Language = "";
    string Year = "";
    string? Error;
    int Page = 1;
    int Total;
    bool Busy;
    int LoadVersion;
    int PageCount => Math.Max(1, (int)Math.Ceiling(Total / 12.0));

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        var version = ++LoadVersion;
        Busy = true;
        Error = null;
        try
        {
            var result = await Api.Albums(Query, Language, Year, Page, 12);
            if (version != LoadVersion)
            {
                return;
            }

            AlbumItems.Clear();
            AlbumItems.AddRange(result.Items);
            Total = result.Total;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            Error = "The music catalog is unavailable. Check the API and database connection.";
        }
        finally
        {
            if (version == LoadVersion)
            {
                Busy = false;
            }
        }
    }

    async Task Search()
    {
        Page = 1;
        await Load();
    }

    async Task SearchKey(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter")
        {
            await Search();
        }
    }

    async Task Previous()
    {
        Page--;
        await Load();
    }

    async Task Next()
    {
        Page++;
        await Load();
    }

    async Task GoTo(int destination)
    {
        Page = destination;
        await Load();
    }
}
