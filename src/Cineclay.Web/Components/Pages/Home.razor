@page "/"
@page "/watchlist"
@page "/reviews"
@inject CatalogClient Api
@inject Visitor Visitor
@inject NavigationManager Nav
<PageTitle>Cineclay — A world of cinema</PageTitle>
@if(Error is not null){<div class="notice" role="alert">@Error <button @onclick="Load">Try again</button></div>}
@if(IsHome){
<div class="intro"><div><span class="eyebrow">For the love of cinema</span><h1>Your next great story starts here.</h1></div><p>Movies. Series. Every era. One place.</p></div>
<CinemaHero Titles="Highlights" Explore="Open" Trailer="OpenTrailer"/>}
<section class="catalog-totals" aria-label="Catalog totals"><div><strong>@Stats.Movies.ToString("N0")</strong><span>Movies indexed</span></div><div><strong>@Stats.TvSeries.ToString("N0")</strong><span>TV series</span></div><div><strong>@Stats.Total.ToString("N0")</strong><span>Total titles in PostgreSQL</span></div><div><strong>@Stats.Genres</strong><span>Genres</span></div><p>
    @(Stats.Total >= 12000
        ? "The complete checked-in catalog is loaded in PostgreSQL."
        : "The seed catalog is loaded. Import the public archive to expand coverage.")
</p></section>
<PlatformDirectory/><section id="catalog"><div class="catalog-head"><div><h2>@(IsWatchlist?"Your personal watchlist":IsReviews?"Your film journal":"Find your kind of cinema")</h2><p>@(IsReviews?"Open a film to read and write your reviews.":"A whole world of stories, waiting to be discovered.")</p></div><span class="count">@Total.ToString("N0") titles</span></div><div class="filters"><label class="search">⌕ <input type="search" aria-label="Search movies, cast and directors" placeholder="Search movies, actors, directors…" @bind="Query" @bind:event="oninput" @onkeyup="SearchKey"/></label><button class="secondary" @onclick="Search">Search</button><select aria-label="Release year" @bind="Year" @bind:after="Search"><option value="">All years</option>@for(var y=DateTime.Now.Year;y>=1990;y--){<option value="@y">@y</option>}</select><select aria-label="Genre" @bind="Genre" @bind:after="Search"><option value="">All genres</option>@foreach(var g in Genres){<option>@g</option>}</select><select aria-label="Original language" @bind="Language" @bind:after="Search"><option value="">All languages</option>@foreach(var language in LanguageOptions){<option>@language</option>}</select><div class="sort"><span>Sort by:</span><select aria-label="Sort movies" @bind="Sort" @bind:after="Search"><option value="curated">Curated for you</option><option value="new">Newest first</option><option value="old">Oldest first</option><option value="rating">Highest score</option><option value="title">Title A–Z</option></select></div></div><div class="media-tabs" role="group" aria-label="Media type"><button class="@(MediaType==""?"active":"")" aria-pressed="@(MediaType==""?"true":"false")" @onclick="()=>ChooseType(0)">All titles</button><button class="@(MediaType=="movie"?"active":"")" aria-pressed="@(MediaType=="movie"?"true":"false")" @onclick="()=>ChooseType(1)">Movies</button><button class="@(MediaType=="tv"?"active":"")" aria-pressed="@(MediaType=="tv"?"true":"false")" @onclick="()=>ChooseType(2)">TV series</button></div><div class="genre-tabs"><button class="chip @(Genre==""?"active":"")" @onclick="Reset">✦ All movies</button>@foreach(var g in Genres.Take(8)){<button class="chip @(Genre==g?"active":"")" @onclick="()=>ChooseGenre(g)">@g</button>}</div>
<div class="catalog-results" aria-busy="@Busy">
    @if(Busy)
    {
        <div class="catalog-loader" role="status" aria-live="polite">
            <span class="loading-orb" aria-hidden="true"><i></i><i></i><i></i></span>
            <strong>Finding great stories</strong>
            <small>Refreshing your selection…</small>
        </div>
    }
    <div class="movie-grid @(Busy ? "is-loading" : "")">
        @foreach(var m in Movies){<MovieCard Movie="m" Saved="Saved.Contains(m.Id)" Explore="Open" Toggle="Toggle"/>}
        @if(!Busy&&Movies.Count==0){<div class="empty"><h3>No films here yet.</h3><p>Try another filter, save a film to your watchlist, or import more films in Studio.</p><button class="primary" @onclick="Reset">Reset filters</button></div>}
    </div>
</div>
<nav class="catalog-pagination" aria-label="Catalog pagination">
    <button class="page-direction" disabled="@(Page==1||Busy)" @onclick="Previous"><span aria-hidden="true">←</span> Previous</button>
    <div class="page-status">
        <strong>Showing @(Total==0?0:(Page-1)*24+1)–@Math.Min(Page*24,Total)</strong>
        <span>of @Total.ToString("N0") titles</span>
    </div>
    <div class="page-numbers" aria-label="Page @Page of @Math.Max(1,(int)Math.Ceiling(Total/24.0))">
        @for(var n=Math.Max(1,Page-2);n<=Math.Min((int)Math.Ceiling(Total/24.0),Page+2);n++){var destination=n;<button class="page-number @(n==Page?"active":"")" aria-current="@(n==Page?"page":null)" @onclick="()=>GoTo(destination)">@n</button>}
    </div>
    <span class="page-count">Page @Page of @Math.Max(1,(int)Math.Ceiling(Total/24.0))</span>
    <button class="page-direction" disabled="@(Page*24>=Total||Busy)" @onclick="Next">Next <span aria-hidden="true">→</span></button>
</nav></section>
@if(IsHome){<section><div class="section-line"><h2>A journey through the decades</h2><span>Every era has a story ↗</span></div><div class="decades">@foreach(var y in new[]{1990,2000,2010,2020}){<button class="decade" @onclick="()=>ChooseYear(y)"><div><strong>@(y)s</strong><span>Start exploring in @y</span></div><i>✧</i></button>}</div></section>}
@if(Selected is {} movie){<div class="modal-overlay"><section class="native-modal" role="dialog" aria-modal="true" aria-label="@movie.Title"><div class="modal-header"><span class="eyebrow">The film journal</span><button class="close" @onclick="Close" aria-label="Close">×</button></div>@if(PlayTrailer&&movie.Trailer.Length==11){<iframe class="trailer-frame" src="@($"https://www.youtube-nocookie.com/embed/{movie.Trailer}")" title="@movie.Title trailer" allowfullscreen></iframe><p style="padding:20px"><a href="@($"https://www.youtube.com/watch?v={movie.Trailer}")" target="_blank" rel="noopener">Open trailer on YouTube ↗</a></p>}else{<div class="modal-body"><div>@if(movie.Poster!=""){<img style="width:100%;border-radius:12px" src="@movie.Poster" alt="@movie.Title poster"/>}</div><div><h2>@movie.Title</h2><div class="detail-meta">@movie.Year · @movie.Runtime min · @string.Join(" / ",movie.Genres)</div><p>@movie.Summary</p>@if(movie.SourceUrl!=null){<a class="source-link" href="@movie.SourceUrl" target="_blank" rel="noopener">@movie.Source source ↗</a>}<div class="detail-section">Directed by</div><p>@movie.Director</p><div class="detail-section">Actors & actresses</div><div class="cast">@foreach(var c in movie.Cast){<span>@c</span>}</div><div class="detail-section">Where to watch</div><select aria-label="Streaming region" @bind="Region"><option>IN</option><option>US</option><option>GB</option></select>@foreach(var p in movie.Providers.Where(p=>(p.Region==Region||p.Region=="GLOBAL"))){<ProviderLink Provider="p"/>}
@if(!movie.Providers.Any(p=>(p.Region==Region||p.Region=="GLOBAL"))){<p class="note">Availability has not been imported for this region.</p><a class="watch-link" href="@($"https://www.justwatch.com/{(Region=="IN"?"in":Region=="GB"?"uk":"us")}/search?q={Uri.EscapeDataString(movie.Title)}")" target="_blank" rel="noopener">Search JustWatch ↗</a>}
<p class="note">Imported availability: JustWatch via TMDB. Imported links open TMDB’s watch page; manually verified links can go directly to an OTT title. Availability can change.</p>@if(movie.Trailer!=""){<button class="primary" @onclick="()=>PlayTrailer=true">▷ Watch trailer</button>}<div class="review-box"><b>Your review</b><EditForm Model="Review" OnValidSubmit="SaveReview" FormName="review"><DataAnnotationsValidator/><ValidationSummary/><InputSelect @bind-Value="Review.Rating">@for(var n=5;n>=1;n--){<option value="@n">@n stars</option>}</InputSelect><InputTextArea @bind-Value="Review.Text" aria-label="Review" placeholder="What stayed with you?"/><button class="primary" disabled="@Busy">Save review</button></EditForm>@foreach(var r in MovieReviews){<div class="review-item"><b>@r.Rating / 5 · Your review</b>@r.Text</div>}</div></div></div>}</section></div>}
@code{
 Movie? Selected;List<Movie> Highlights=[];CatalogStats Stats=new(0,0,0);string Language="";List<string> LanguageOptions=[];string MediaType="";List<Movie> Movies=[];List<long> Saved=[];List<MovieReview> MovieReviews=[];ReviewInput Review=new();string Query="",Year="",Genre="",Sort="curated",Region="IN";int Page=1,Total;bool Busy,PlayTrailer;string? Error;bool IsHome=>new Uri(Nav.Uri).AbsolutePath=="/";bool IsWatchlist=>Nav.Uri.EndsWith("/watchlist");bool IsReviews=>Nav.Uri.EndsWith("/reviews");
 readonly string[] Genres=["Science Fiction","Drama","Thriller","Action","Comedy","Romance","Animation","Adventure","Crime","Fantasy","History","Music","Horror","Family","Documentary","Biography","Mystery","War","Western","Sport","Anime","Legal","Medical","Espionage","Supernatural","Food","Adult","Sports"];
 protected override async Task OnParametersSetAsync(){await Load();}
 async Task Load(){Busy=true;Error=null;try{Saved=await Api.Saved(Visitor.Id);Stats=await Api.Stats();if(LanguageOptions.Count==0)LanguageOptions=(await Api.AssistantCatalog()).SelectMany(m=>m.Languages).Distinct().Order().ToList();if(Highlights.Count==0)Highlights=[..await Api.Spotlight("movie"),..await Api.Spotlight("tv")];var result=await Api.List(Query,Year,Genre,Sort,Page,24,MediaType,Language);Movies=result.Items;Total=result.Total;if(IsWatchlist){var all=new List<Movie>();for(var p=1;;p++){var batch=await Api.List(Query,Year,Genre,Sort,p,100,MediaType,Language);all.AddRange(batch.Items.Where(m=>Saved.Contains(m.Id)));if(p*100>=batch.Total)break;}Total=all.Count;Movies=all.Skip((Page-1)*24).Take(24).ToList();}}catch(Exception e)when(e is HttpRequestException or TaskCanceledException){Error="The catalog is unavailable. Check the API and database connection.";}finally{Busy=false;}}
 async Task ChooseType(int type){MediaType=type==1?"movie":type==2?"tv":"";await Search();}async Task OpenTrailer(Movie movie){await Open(movie);PlayTrailer=true;}
 async Task Search(){Page=1;await Load();}async Task SearchKey(KeyboardEventArgs e){if(e.Key=="Enter")await Search();}async Task ChooseGenre(string genre){Genre=genre;await Search();}async Task ChooseYear(int y){Year=y.ToString();await Search();}async Task Classics(){Year="1990";Sort="old";await Search();}async Task Reset(){Query=Year=Genre=MediaType=Language="";Sort="curated";await Search();}async Task GoTo(int destination){Page=destination;await Load();}async Task Next(){Page++;await Load();}async Task Previous(){Page--;await Load();}
 async Task Toggle(long id){try{var save=!Saved.Contains(id);await Api.Watch(Visitor.Id,id,save);if(save)Saved.Add(id);else Saved.Remove(id);if(IsWatchlist)await Load();}catch(HttpRequestException){Error="Could not save your watchlist. Try again.";}}
 async Task Open(Movie m){Selected=m;PlayTrailer=false;Review=new();MovieReviews=await Api.Reviews(Visitor.Id,m.Id);}async Task OpenId(long id,bool trailer=false){var result=await Api.List("Dune: Part Two");var m=result.Items.FirstOrDefault(x=>x.Id==id);if(m!=null){await Open(m);PlayTrailer=trailer;}}void Close(){Selected=null;PlayTrailer=false;}async Task SaveReview(){if(Selected==null)return;try{await Api.Review(Visitor.Id,Selected.Id,Review);MovieReviews=await Api.Reviews(Visitor.Id,Selected.Id);Review=new();}catch(HttpRequestException){Error="Your review could not be saved. Please try again.";}}
}
