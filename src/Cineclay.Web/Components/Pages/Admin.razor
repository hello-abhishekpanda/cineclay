@page "/admin"
@attribute [Authorize(Roles="Admin")]
@inject CatalogClient Api
<PageTitle>Studio — Cineclay</PageTitle>
<div class="admin-intro"><div><span class="eyebrow">Cineclay Studio</span><h1>Make room for more stories.</h1><p>Manage your catalog, artwork and watch links.</p></div><form action="/auth/logout" method="post" data-enhance="false"><AntiforgeryToken/><button class="secondary">Sign out</button></form></div>
@if(Message!=""){<div class="notice" role="status">@Message</div>}
<div class="stats"><div class="stat"><span>Titles in your catalog</span><strong>@Stats.Total</strong></div><div class="stat"><span>Years represented</span><strong>@Stats.Years</strong></div><div class="stat"><span>Genres to discover</span><strong>@Stats.Genres</strong></div><div class="stat"><span>Persistence</span><strong style="font-size:20px">PostgreSQL</strong></div></div>
<div class="admin-tabs"><button @onclick="Library">Film library</button><button @onclick="New">Manual entry</button><button @onclick="ImportTab">Import from TMDB</button></div>
@if(Tab=="catalog"){<div class="filters"><label class="search"><input @bind="Query" placeholder="Search library…"/></label><button class="primary" @onclick="Load">Search</button></div><div class="table-wrap"><table><thead><tr><th>Film</th><th>Year</th><th>Source</th><th>Actions</th></tr></thead><tbody>@foreach(var m in Movies){<tr><td>@m.Title</td><td>@m.Year</td><td>@m.Source</td><td><button @onclick="()=>Edit(m)">Edit</button><button @onclick="()=>DeleteTarget=m">Remove</button></td></tr>}</tbody></table></div><div class="load-row"><button class="secondary" disabled="@(Page==1||Busy)" @onclick="Prev">← Previous</button><span> Page @Page · @Total films </span><button class="secondary" disabled="@(Page*50>=Total||Busy)" @onclick="Next">Next →</button></div>}
@if(Tab=="add"){<section class="form-panel"><h2>@(Editing?"Edit this film":"Add a new story.")</h2><EditForm Model="Model" OnValidSubmit="Save" FormName="movie"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><label>Content type<InputSelect @bind-Value="Model.MediaType"><option value="movie">Movie</option><option value="tv">TV series</option></InputSelect></label><label>Title *<InputText @bind-Value="Model.Title"/></label><label>Release year *<InputNumber @bind-Value="Model.Year"/></label><label>Genres (comma separated) *<input @bind="GenreCsv" required/></label><label>Original language(s), comma separated<input @bind="LanguageCsv"/></label><label>Director<InputText @bind-Value="Model.Director"/></label><label class="full">Actors & actresses (comma separated) *<input @bind="CastCsv" required/></label><label class="full">Summary *<InputTextArea @bind-Value="Model.Summary"/></label><label>Poster URL (HTTPS)<InputText @bind-Value="Model.Poster"/></label><label>Runtime (minutes)<InputNumber @bind-Value="Model.Runtime"/></label><label>YouTube trailer ID<InputText @bind-Value="Model.Trailer"/></label><label>OTT platform<input @bind="ProviderName"/></label><label>Direct OTT URL (HTTPS)<input @bind="ProviderUrl" type="url"/></label><label>Watch region<select @bind="ProviderRegion"><option>IN</option><option>US</option><option>GB</option></select></label><label class="full">Editorial review<InputTextArea @bind-Value="Model.Review"/></label></div><p class="note">Adding an OTT offer preserves existing imported offers. Review links and regional availability before publishing.</p><button class="primary" disabled="@Busy">Save film ↗</button></EditForm></section>}
@if(Tab=="import"){<section class="form-panel"><h2>Bring the world of cinema in.</h2><p>Public archive: run <code>python scripts/scrape_catalog.py</code>, then <code>python scripts/load_public_catalog.py</code> with ADMIN_API_KEY in your environment to store Wikipedia and TVmaze records in PostgreSQL. These scripts require no TMDB token.</p><label>Metadata source<select @bind="ImportSource"><option value="tmdb">TMDB movies</option><option value="tvmaze">TVmaze series (no token)</option></select></label><p>Import posters, credits, official YouTube trailers and regional streaming availability. Requires TMDB_TOKEN on the API server. No arbitrary website scraping is used.</p><div class="form-grid"><label>Import mode<select @bind="ImportByYear"><option value="false">Single film by TMDB ID</option><option value="true">Release year (one page at a time)</option></select></label><label>@(ImportByYear?"Year":"TMDB ID")<input type="number" @bind="ImportValue" min="1"/></label>@if(ImportByYear){<label>Page (1–500)<input type="number" @bind="ImportPage" min="1" max="500"/></label>}</div><button class="primary" disabled="@Busy" @onclick="Import">@(Busy?"Importing…":"Import metadata ↗")</button><p class="note">Each year page imports up to 20 titles. Repeat pages to expand coverage; matching IDs are updated. Partial failures are reported. Attribution: TMDB / JustWatch. TMDB links do not supply direct provider deep links.</p></section>}
@if(DeleteTarget is {} target){<div class="modal-overlay"><div class="native-modal" role="dialog" aria-modal="true" style="max-width:450px;padding:30px"><h2>Remove @target.Title?</h2><p>The film will be hidden. Its record remains recoverable in PostgreSQL.</p><button class="primary" @onclick="Delete">Remove film</button><button class="secondary" @onclick="()=>DeleteTarget=null">Cancel</button></div></div>}
@code{
 string LanguageCsv="",ImportSource="tmdb",Tab="catalog",Query="",Message="",GenreCsv="",CastCsv="",ProviderName="",ProviderUrl="",ProviderRegion="IN";bool Editing,Busy,ImportByYear;int ImportValue=693134,ImportPage=1,Page=1,Total;Movie Model=Fresh();Movie? DeleteTarget;List<Movie> Movies=[];CatalogStats Stats=new(0,0,0);
 static Movie Fresh()=>new(){Genres=["Drama"],Cast=["Cast not yet announced"]};
 protected override async Task OnInitializedAsync()=>await Load();
 async Task Load(){try{var result=await Api.List(Query,page:Page,size:50);Movies=result.Items;Total=result.Total;Stats=await Api.Stats();}catch(HttpRequestException){Message="Catalog unavailable. Check the API and database.";}}
 async Task Library(){Tab="catalog";Page=1;await Load();}void ImportTab(){Tab="import";}void New(){Tab="add";Editing=false;Model=Fresh();GenreCsv=CastCsv=LanguageCsv=ProviderName=ProviderUrl="";Message="";}
 void Edit(Movie m){Model=System.Text.Json.JsonSerializer.Deserialize<Movie>(System.Text.Json.JsonSerializer.Serialize(m))!;LanguageCsv=string.Join(", ",m.Languages);GenreCsv=string.Join(", ",m.Genres);CastCsv=string.Join(", ",m.Cast);ProviderName=ProviderUrl="";Editing=true;Tab="add";}
 async Task Save(){Busy=true;try{Model.Languages=LanguageCsv.Split(',',StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries);Model.Genres=GenreCsv.Split(',',StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries);Model.Cast=CastCsv.Split(',',StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries);if((ProviderName!="")!=(ProviderUrl!="")){Message="Supply both an OTT name and URL.";return;}if(ProviderUrl!="")Model.Providers.Add(new(){Name=ProviderName,Url=ProviderUrl,Region=ProviderRegion,Type="manual",CheckedAt=DateTime.UtcNow.ToString("yyyy-MM-dd")});var error=Model.Validate();if(error!=null){Message=error;return;}if(!Editing)Model.Id=DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();Model.Source=Editing?Model.Source:"Manual";await Api.Save(Model);Message="Film saved to PostgreSQL.";await Library();}catch(HttpRequestException e){Message=e.Message;}finally{Busy=false;}}
 async Task Delete(){if(DeleteTarget==null)return;try{await Api.Delete(DeleteTarget.Id);DeleteTarget=null;await Load();Message="Film hidden. The database record was preserved.";}catch(HttpRequestException e){Message=e.Message;}}
 async Task Import(){Busy=true;try{Message=ImportSource=="tvmaze"?await Api.ImportTv(ImportValue):await Api.Import(ImportValue,ImportByYear,ImportPage);Stats=await Api.Stats();}catch(HttpRequestException e){Message=e.Message;}finally{Busy=false;}}async Task Prev(){Page--;await Load();}async Task Next(){Page++;await Load();}
}
