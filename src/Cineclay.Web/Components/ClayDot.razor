@implements IDisposable
@inject CatalogClient Api
@inject ClayDotSession Session
<div id="claydot-root"><button class="claydot-launcher" aria-label="Open clayDot movie assistant" aria-expanded="@Opened" @onclick="()=>Opened=!Opened"><span class="dot-orb"><i></i><i></i></span>@if(!Opened){<span class="dot-label">Ask clayDot</span>}</button>
@if(Opened){<section class="claydot-panel" role="dialog" aria-label="clayDot movie assistant"><header><div class="dot-orb tiny"><i></i><i></i></div><div><b>clay<span>Dot</span></b><small>Your cinema companion</small></div><button @onclick="()=>Opened=false" aria-label="Close clayDot">×</button></header><div class="claydot-body">
@if(Error!=""){<p class="dot-muted">@Error</p>}
@if(Selected is {} selected){<span class="dot-kicker">WHERE TO WATCH</span><h3>@selected.Title</h3><p>@selected.Summary</p>@if(selected.Providers.Count>0){@foreach(var offer in selected.Providers.Where(p=>p.Region=="IN"||p.Region=="GLOBAL")){<ProviderLink Provider="offer"/>}<p class="dot-muted">Official title pages are not a guarantee of regional subscription availability.</p>}else{<p class="dot-muted">No verified offer is indexed for your region. I won't guess a platform or free stream.</p><a class="dot-offer" href="@($"https://www.justwatch.com/in/search?q={Uri.EscapeDataString(selected.Title)}")" target="_blank" rel="noopener">Check this title on JustWatch ↗</a>}
@if(selected.Trailer!=""){<a class="dot-offer" href="@($"https://www.youtube.com/watch?v={selected.Trailer}")" target="_blank" rel="noopener">Official trailer ↗</a>}<button class="dot-text" @onclick="Reset">← Back to clayDot</button>
}else if(Step==0){<span class="dot-kicker">A SMALL DOT. A GREAT NEXT WATCH.</span><h3>Your mood.<br/>Your next great story.</h3><p>Hi, I’m clayDot. Three questions, then a little watchlist for tonight.</p><button class="dot-primary" @onclick="Start">Find my next watch ✦</button><div class="dot-divider">or find where to watch</div><input aria-label="Ask clayDot about a title" @bind="Query" placeholder="Movie or series name…"/><button class="dot-text" @onclick="Search">Search catalog ↗</button>@foreach(var movie in SearchResults){<button class="dot-title-result" @onclick="()=>Selected=movie">@movie.Title · @movie.Year ↗</button>}
}else if(Step==1){<span class="dot-kicker">QUESTION 1 OF 3</span><h3>How do you want to feel?</h3><div class="dot-options">@foreach(var mood in new[]{"Light & happy","On the edge","Somewhere else","Moved & inspired"}){<button @onclick="()=>ChooseMood(mood)"><strong>@mood</strong></button>}</div>
}else if(Step==2){<span class="dot-kicker">QUESTION 2 OF 3</span><h3>What does tonight look like?</h3><div class="dot-options">@foreach(var format in new[]{"A short movie night","A big-screen escape","One more episode","Surprise me"}){<button @onclick="()=>ChooseFormat(format)"><strong>@format</strong></button>}</div>
}else if(Step==3){<span class="dot-kicker">QUESTION 3 OF 3</span><h3>Which language feels right?</h3><div class="dot-language-options">@foreach(var lang in new[]{"Any language"}.Concat(Catalog.SelectMany(m=>m.Languages).Distinct().Order())){<button @onclick="()=>ChooseLanguage(lang)">@lang</button>}</div>
}else{<span class="dot-kicker">YOUR MOVIE-NIGHT EDIT</span><h3>A little mood. A good story.</h3><p>Matched to your genres, format and language.</p>@foreach(var movie in Recommendations){<article class="dot-result"><button @onclick="()=>Selected=movie">@if(movie.Poster!=""){<img src="@movie.Poster" alt=""/>}<span><strong>@movie.Title</strong><small>@movie.Year · @string.Join(" / ",movie.Languages)</small><em>@string.Join(" · ",movie.Genres.Where(g=>Wanted.Contains(g)))</em></span></button><button class="dot-watch" @onclick="()=>Selected=movie">Where can I watch? ↗</button></article>}@if(Recommendations.Count==0){<p class="dot-muted">No enriched titles match all three choices yet. Try another language or format.</p>}<button class="dot-primary" @onclick="Start">Find another mood</button>}
<div class="dot-free"><b>Explore legal free catalogs</b><p>These service links do not confirm that a particular title is free in your region. Ads and country restrictions may apply.</p><a href="https://tubitv.com/" target="_blank" rel="noopener">Tubi ↗</a><a href="https://watch.plex.tv/on-demand" target="_blank" rel="noopener">Plex ↗</a><a href="https://pluto.tv/" target="_blank" rel="noopener">Pluto TV ↗</a></div></div><footer>Catalog matching · No generative AI model connected</footer></section>}
</div>
@code{
 bool Opened;int Step;string Mood="",Format="",Language="",Query="",Error="";Movie? Selected;List<Movie> Catalog=[],Recommendations=[],SearchResults=[];
 string[] Wanted=>Mood switch{"Light & happy"=>["Comedy","Romance","Family","Music"],"On the edge"=>["Thriller","Crime","Mystery","Horror"],"Somewhere else"=>["Fantasy","Adventure","Science Fiction","Animation","Supernatural"],_=>["Drama","Biography","History","Documentary"]};
 protected override void OnInitialized(){Session.Requested+=OpenFor;}
 void OpenFor(Movie movie){Selected=movie;Opened=true;_ = InvokeAsync(StateHasChanged);}
 async Task Start(){Selected=null;Step=1;Error="";try{Catalog=await Api.AssistantCatalog();}catch(HttpRequestException){Error="The catalog is unavailable. Please try again.";}}
 void ChooseMood(string value){Mood=value;Step=2;}void ChooseFormat(string value){Format=value;Step=3;}
 void ChooseLanguage(string language){Language=language;Step=4;Recommendations=Catalog.Where(m=>(Language=="Any language"||m.Languages.Contains(Language))&&(Format=="Surprise me"||Format=="One more episode"&&m.MediaType=="tv"||Format=="A short movie night"&&m.MediaType=="movie"&&m.Runtime.HasValue&&m.Runtime<=125||Format=="A big-screen escape"&&m.MediaType=="movie"&&m.Runtime>125)).Where(m=>m.Genres.Any(Wanted.Contains)).OrderByDescending(m=>m.Genres.Count(Wanted.Contains)*10+(m.Score??0)).Take(3).ToList();}
 void Reset(){Selected=null;Step=0;}async Task Search(){try{SearchResults=(await Api.List(Query,size:6)).Items;}catch(HttpRequestException){Error="Could not search the catalog.";}}
 public void Dispose(){Session.Requested-=OpenFor;}
}
