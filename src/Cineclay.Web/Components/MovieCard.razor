@inject ClayDotSession Dot
<article class="movie-card"><div class="poster-wrap"><button class="poster-click" @onclick="()=>Explore.InvokeAsync(Movie)" aria-label="Explore @Movie.Title">@if(!string.IsNullOrEmpty(Movie.Poster)){<img src="@Movie.Poster" alt="@Movie.Title theatrical poster" loading="lazy"/>}else{<span class="fallback-title">@Movie.Title</span>}</button>@if(Movie.Score.HasValue){<span class="rating-badge" title="@(Movie.Source=="TMDB"?"TMDB audience score":"Sample catalog score")">★ @Movie.Score.Value.ToString("0.0")</span>}<button class="bookmark @(Saved?"saved":"")" @onclick="()=>Toggle.InvokeAsync(Movie.Id)" aria-label="@(Saved?"Remove from watchlist":"Add to watchlist")" aria-pressed="@Saved">♧</button></div><h3><button @onclick="()=>Explore.InvokeAsync(Movie)">@Movie.Title</button></h3><div class="card-meta"><span>@Movie.Year</span><span>·</span><span>@(Movie.MediaType=="tv"?"TV":"Film")</span><span>·</span><span>@Movie.Genres.FirstOrDefault()</span></div><div class="platforms">@if(Movie.Providers.FirstOrDefault(p=>p.Region=="IN"||p.Region=="GLOBAL") is {} offer){<a class="platform-icon" href="@offer.Url" target="_blank" rel="noopener">@if(ProviderLink.Logo(offer.Name)!=""){<img class="ott-logo" src="@ProviderLink.Logo(offer.Name)" alt="@offer.Name logo"/>}<span>@offer.Name</span></a>}else{<button class="ask-watch" @onclick="()=>Dot.Open(Movie)">◎ Find where to watch</button>}</div></article>
@code{[Parameter,EditorRequired]public Movie Movie{get;set;}=default!;[Parameter]public bool Saved{get;set;}[Parameter]public EventCallback<Movie> Explore{get;set;}[Parameter]public EventCallback<long> Toggle{get;set;}}
